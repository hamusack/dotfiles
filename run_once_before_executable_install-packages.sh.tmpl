#!/bin/bash
# chezmoi run_once script - 初回セットアップ時に自動実行される
# ファイル名の "before" は chezmoi apply の前に実行されることを意味する

set -euo pipefail

echo "🚀 dotfiles セットアップを開始します..."

# ==============================================================================
# Homebrew のインストール
# ==============================================================================
if ! command -v brew &> /dev/null; then
    echo "📦 Homebrew をインストール中..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Homebrew のパス設定（実際のパスをチェック）
if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
else
    echo "⚠️  Homebrew が見つかりません"
    exit 1
fi

echo "✅ Homebrew: $(brew --prefix)"

# ==============================================================================
# Brewfile からパッケージをインストール
# ==============================================================================
BREWFILE_PATH="{{ .chezmoi.sourceDir }}/Brewfile"

if [[ -f "$BREWFILE_PATH" ]]; then
    echo "📦 Brewfile からパッケージをインストール中..."
    brew bundle --file="$BREWFILE_PATH"
else
    echo "⚠️  Brewfile が見つかりません: $BREWFILE_PATH"
fi

# ==============================================================================
# VSCode 拡張のインストール（オプション）
# ==============================================================================
VSCODE_BREWFILE="{{ .chezmoi.sourceDir }}/Brewfile.vscode"

if command -v code &> /dev/null && [[ -f "$VSCODE_BREWFILE" ]]; then
    echo "📦 VSCode 拡張をインストール中..."
    brew bundle --file="$VSCODE_BREWFILE" || echo "⚠️  一部の VSCode 拡張のインストールに失敗しました"
else
    echo "ℹ️  VSCode が見つからないため、拡張のインストールをスキップ"
    echo "   後で実行: brew bundle --file=\$(chezmoi source-path)/Brewfile.vscode"
fi

# ==============================================================================
# Zinit (Zsh プラグインマネージャー) のインストール
# ==============================================================================
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

if [[ ! -d "$ZINIT_HOME" ]]; then
    echo "📦 Zinit をインストール中..."
    mkdir -p "$(dirname "$ZINIT_HOME")"
    git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
else
    echo "✅ Zinit は既にインストール済み"
fi

# ==============================================================================
# TPM (tmux プラグインマネージャー) のインストール
# ==============================================================================
TPM_PATH="${HOME}/.tmux/plugins/tpm"

if [[ ! -d "$TPM_PATH" ]]; then
    echo "📦 TPM (tmux plugin manager) をインストール中..."
    git clone https://github.com/tmux-plugins/tpm "$TPM_PATH"
else
    echo "✅ TPM は既にインストール済み"
fi

# ==============================================================================
# 完了メッセージ
# ==============================================================================
echo ""
echo "🎉 セットアップが完了しました！"
echo ""
echo "📝 次のステップ:"
echo "   1. シェルを再起動するか、'source ~/.zshrc' を実行"
echo "   2. tmux を起動して、prefix + I でプラグインをインストール"
echo "   3. 必要な環境変数を設定（README.md 参照）"
echo ""
